integrator        = md
dt                = 0.001
nsteps            = 10000000
gen-vel           = no
continuation      = yes
nstxout-compressed = 10000    ; every 10 ps
compressed-x-precision = 1000
cutoff-scheme     = Verlet
nstcalcenergy     = 100
nstenergy         = 100       ; 0.1 ps at dt = 1 fs
nstlog            = 100000
coulombtype       = PME
rcoulomb          = 0.9
fourierspacing    = 0.10
pme-order         = 4
ewald-rtol        = 1e-5
vdwtype           = Cut-off
vdw-modifier      = Potential-shift
rvdw              = 0.9
DispCorr          = EnerPres
tcoupl            = V-rescale
tc-grps           = System
tau-t             = 1.0
ref-t             = 250
pcoupl            = C-rescale
pcoupltype        = isotropic
tau-p             = 2.0
ref-p             = 1.0
compressibility   = 4.5e-5
