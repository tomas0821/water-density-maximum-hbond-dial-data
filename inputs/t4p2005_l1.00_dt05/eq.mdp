integrator        = md
dt                = 0.0005
nsteps            = 4000000
gen-vel           = yes
gen-temp          = 280
gen-seed          = -1
continuation      = no
nstxout-compressed = 0
cutoff-scheme     = Verlet
nstcalcenergy     = 200
nstenergy         = 200       ; 0.1 ps at dt = 0.5 fs
nstlog            = 100000
coulombtype       = PME
rcoulomb          = 0.9
fourierspacing    = 0.10
pme-order         = 4
ewald-rtol        = 1e-5
vdwtype           = Cut-off
vdw-modifier      = Potential-shift
rvdw              = 0.9
DispCorr          = EnerPres
tcoupl            = V-rescale
tc-grps           = System
tau-t             = 1.0
ref-t             = 280
pcoupl            = C-rescale
pcoupltype        = isotropic
tau-p             = 2.0
ref-p             = 1.0
compressibility   = 4.5e-5
